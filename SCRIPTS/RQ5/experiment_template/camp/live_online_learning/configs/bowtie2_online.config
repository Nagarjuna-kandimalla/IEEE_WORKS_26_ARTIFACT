includeConfig 'bowtie2_base.config'
includeConfig 'camp_online_ebpf_race_safe.config'

params.camp_online_mode = 'online_learning'
params.camp_allocation_variant = 'A+P+C'
params.camp_allocate_script = (
    System.getenv('CAMP_ALLOCATE_SCRIPT')
    ?: 'UNSET_CAMP_ALLOCATE_SCRIPT'
)
params.camp_record_script = (
    System.getenv('CAMP_RECORD_SCRIPT')
    ?: 'UNSET_CAMP_RECORD_SCRIPT'
)
params.queue_size = 384
executor.submitRateLimit = '4/1sec'

profiles {
    slurm {
        process.queue = System.getenv('CAMP_SLURM_QUEUE') ?: 'main'
        process.clusterOptions = (
            '--nodes=1 --nodelist='
            + (System.getenv('CAMP_WORKER_NODELIST') ?: 'mempred-worker-[01-12]')
            + ' --constraint='
            + (System.getenv('CAMP_WORKER_CONSTRAINT') ?: 'standard')
        )
        executor.queueSize = (
            System.getenv('CAMP_QUEUE_SIZE') ?: '384'
        ).toInteger()
    }
}

process {
    maxRetries = 2

    withName: 'DOWNLOAD_REFERENCE' {
        maxForks = 1
        maxRetries = 5
    }
    withName: 'DOWNLOAD_RUN' {
        maxForks = 4
        maxRetries = 5
    }
}
