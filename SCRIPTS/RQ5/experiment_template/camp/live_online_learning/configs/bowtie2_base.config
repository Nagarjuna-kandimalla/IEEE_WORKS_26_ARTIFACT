includeConfig 'camp_online_ebpf.config'

def campAllocate = {
    String processName,
    String taskInstance,
    long inputBytes,
    String inputClass,
    int requestedThreads,
    String taskHash,
    int attempt ->
    def command = [
        params.camp_python.toString(),
        params.camp_allocate_script.toString(),
        '--run-id', params.camp_run_id.toString(),
        '--task-key', taskHash.replace('/', ''),
        '--attempt', attempt.toString(),
        '--workflow', 'bowtie2',
        '--process', processName,
        '--version', params.camp_workflow_version.toString(),
        '--system-config-id', params.camp_system_config_id.toString(),
        '--task-instance', taskInstance,
        '--input-bytes', Math.max(inputBytes, 1L).toString(),
        "--staged-${inputClass}-input-bytes",
        Math.max(inputBytes, 1L).toString(),
        '--requested-threads', requestedThreads.toString(),
        '--worker-count', '13',
        '--worker-vcpu', '32',
        '--worker-memory-gib', '244.140625',
        '--allocation-variant', params.camp_allocation_variant.toString(),
        '--decision-dir', params.camp_decision_dir.toString(),
        '--prediction-socket', params.camp_prediction_socket.toString(),
        '--retry-multiplier', params.camp_retry_multiplier.toString()
    ].collect { it.toString() }
    def stdout = new StringBuffer()
    def stderr = new StringBuffer()
    def process = new ProcessBuilder(command).start()
    process.waitForProcessOutput(stdout, stderr)
    def status = process.exitValue()
    if (status != 0) {
        throw new IllegalStateException(
            "CAMP allocation failed for ${processName}/${taskInstance}: ${stderr}"
        )
    }
    return "${stdout.toString().trim().toInteger()} MB"
}

def campFeedback = {
    String processName,
    String taskHash,
    int attempt ->
    def safeHash = taskHash.replace('/', '')
    def decision = (
        "${params.camp_decision_dir}/${safeHash}.attempt_${attempt}.json"
    )
    def traceDir = (
        "${params.outdir}/ebpf/${processName}/task_${safeHash}"
    )
    return """
    ${params.camp_python} ${params.camp_record_script} \
      --decision-json '${decision}' \
      --trace-dir '${traceDir}' \
      --outcome-dir '${params.camp_outcome_dir}' \
      --exit-status "\${nxf_main_ret:-0}"
    """
}

params {
    instrumentation = 'ebpf'
    queue_size = 416
    camp_online_mode = 'cold_collection'
    camp_allocation_variant = (
        System.getenv('CAMP_ALLOCATION_VARIANT') ?: 'a'
    )
    camp_run_id = System.getenv('CAMP_RUN_ID') ?: 'UNSET_CAMP_RUN_ID'
    camp_history_db = System.getenv('CAMP_HISTORY_DB') ?: 'UNSET_CAMP_DB'
    camp_outcome_dir = (
        System.getenv('CAMP_OUTCOME_DIR') ?: 'UNSET_CAMP_OUTCOME_DIR'
    )
    camp_decision_dir = (
        System.getenv('CAMP_DECISION_DIR') ?: 'UNSET_CAMP_DECISION_DIR'
    )
    camp_prediction_socket = (
        System.getenv('CAMP_PREDICTION_SOCKET') ?: 'UNSET_CAMP_SOCKET'
    )
    camp_system_config_id = 'sc13'
    camp_workflow_version = 'bowtie2-2.4.2+custom-nextflow'
    camp_python = System.getenv('RQ5_PYTHON') ?: 'python3'
    camp_allocate_script = (
        System.getenv('CAMP_ALLOCATE_SCRIPT') ?: 'UNSET_CAMP_ALLOCATE_SCRIPT'
    )
    camp_record_script = (
        System.getenv('CAMP_RECORD_SCRIPT') ?: 'UNSET_CAMP_RECORD_SCRIPT'
    )
    camp_retry_multiplier = 1.5
    camp_reference_input_bytes = 3784201L
}

profiles {
    slurm {
        process.queue = System.getenv('CAMP_SLURM_QUEUE') ?: 'main'
        process.clusterOptions = (
            '--nodes=1 --nodelist='
            + (System.getenv('CAMP_WORKER_NODELIST') ?: 'mempred-worker-[01-12]')
        )
        executor.queueSize = (
            System.getenv('CAMP_QUEUE_SIZE') ?: '384'
        ).toInteger()
    }
}

process {
    errorStrategy = 'retry'
    maxRetries = 2
    afterScript = {
        campFeedback(
            task.process.tokenize(':')[-1],
            task.hash.toString(),
            task.attempt as int
        )
    }

    withName: 'DOWNLOAD_REFERENCE' {
        memory = {
            campAllocate(
                'DOWNLOAD_REFERENCE',
                'sacCer_ref',
                params.camp_reference_input_bytes as long,
                'external',
                params.ref_cpus as int,
                task.hash.toString(),
                task.attempt as int
            )
        }
    }
    withName: 'BUILD_INDEX' {
        memory = {
            campAllocate(
                'BUILD_INDEX',
                'sacCer_bt2',
                ref_fa.size() as long,
                'external',
                params.index_cpus as int,
                task.hash.toString(),
                task.attempt as int
            )
        }
    }
    withName: 'DOWNLOAD_RUN' {
        memory = {
            campAllocate(
                'DOWNLOAD_RUN',
                run_accession.toString(),
                fastq1_bytes.toString().toLong()
                    + fastq2_bytes.toString().toLong(),
                'external',
                params.download_cpus as int,
                task.hash.toString(),
                task.attempt as int
            )
        }
    }
    withName: 'SPLIT_RUN' {
        memory = {
            campAllocate(
                'SPLIT_RUN',
                run_accession.toString(),
                (fq1.size() as long) + (fq2.size() as long),
                'original',
                params.split_cpus as int,
                task.hash.toString(),
                task.attempt as int
            )
        }
    }
    withName: 'ALIGN_CHUNK' {
        memory = {
            def indexBytes = (
                idxdir.toFile().listFiles()
                    ?.findAll { it.isFile() }
                    ?.sum { it.length() } ?: 0L
            ) as long
            campAllocate(
                'ALIGN_CHUNK',
                "${run_accession}_chunk_${chunk_id}",
                (fq1.size() as long)
                    + (fq2.size() as long)
                    + indexBytes,
                'intermediate',
                params.align_cpus as int,
                task.hash.toString(),
                task.attempt as int
            )
        }
    }
    withName: 'INDEX_BAM' {
        memory = {
            campAllocate(
                'INDEX_BAM',
                "${run_accession}_chunk_${chunk_id}",
                bam.size() as long,
                'intermediate',
                params.bam_index_cpus as int,
                task.hash.toString(),
                task.attempt as int
            )
        }
    }
    withName: 'FLAGSTAT_BAM' {
        memory = {
            campAllocate(
                'FLAGSTAT_BAM',
                "${run_accession}_chunk_${chunk_id}",
                (bam.size() as long) + (bai.size() as long),
                'intermediate',
                params.flagstat_cpus as int,
                task.hash.toString(),
                task.attempt as int
            )
        }
    }
}
