/*
 * Race-safe eBPF task launch for CAMP live deployments.
 *
 * The child must be observably stopped before the tracer starts. Otherwise a
 * fast readiness response can send SIGCONT before SIGSTOP takes effect and
 * leave the task stopped indefinitely.
 */
process {
  beforeScript = {
    def processName = task.process.tokenize(':')[-1]
    def taskId = task.hash.toString().replace('/', '')
    def traceDir = "${params.outdir}/ebpf/${processName}/task_${taskId}"
    """
    sudo -n true >/dev/null 2>&1 || { echo 'ERROR: eBPF requires passwordless sudo on the task host.' >&2; exit 1; }
    sudo -n /usr/bin/python3 -c 'from bcc import BPF' >/dev/null 2>&1 || { echo 'ERROR: system Python cannot import BCC on the task host.' >&2; exit 1; }
    test -x /usr/bin/time || { echo 'ERROR: /usr/bin/time is required for CAMP peak RSS.' >&2; exit 1; }
    mkdir -p '${traceDir}'
    echo \$\$ > '${traceDir}/wrapper_pid.txt'
    __nxf_launch_def="\$(declare -f nxf_launch)"
    eval "\$(printf '%s\\n' "\$__nxf_launch_def" | sed '1s/nxf_launch/nxf_launch_orig/')"
    export -f nxf_launch_orig
    if declare -F nxf_container_env >/dev/null; then
      export -f nxf_container_env
    fi
    nxf_launch() {
      local ready_file='${traceDir}/audit_ready.txt'
      rm -f "\$ready_file" '${traceDir}/camp_time_v.txt' \
        '${traceDir}'/ebpf_attribution_*.tsv
      _audit_task() {
        kill -STOP "\$BASHPID"
        /usr/bin/time -v -o '${traceDir}/camp_time_v.txt' \
          /bin/bash -c nxf_launch_orig
      }
      _audit_task &
      local task_pid=\$!
      echo \$task_pid > '${traceDir}/task_pid.txt'

      local stop_confirmed=false
      local task_state=
      for _ in \$(seq 1 500); do
        if ! kill -0 "\$task_pid" 2>/dev/null; then
          wait "\$task_pid" || true
          return 1
        fi
        task_state="\$(awk '/^State:/ {print \$2}' "/proc/\$task_pid/status" 2>/dev/null || true)"
        if [[ "\$task_state" == T || "\$task_state" == t ]]; then
          stop_confirmed=true
          break
        fi
        sleep 0.01
      done
      if [[ "\$stop_confirmed" != true ]]; then
        echo "ERROR: eBPF target did not enter SIGSTOP before attach." >&2
        kill -TERM "\$task_pid" 2>/dev/null || true
        kill -CONT "\$task_pid" 2>/dev/null || true
        wait "\$task_pid" || true
        return 1
      fi

      sudo -n /usr/bin/python3 '${System.getenv('CAMP_EBPF_TRACER')}' --pid "\$task_pid" --ready-file "\$ready_file" --outdir '${traceDir}' > '${traceDir}/audit_stdout.log' 2> '${traceDir}/audit_stderr.log' < /dev/null &
      local audit_pid=\$!
      echo \$audit_pid > '${traceDir}/audit_launcher_pid.txt'
      local ready_wait=0
      while [[ ! -f "\$ready_file" ]]; do
        if ! kill -0 "\$audit_pid" 2>/dev/null; then
          wait "\$audit_pid" || true
          kill -TERM "\$task_pid" 2>/dev/null || true
          kill -CONT "\$task_pid" 2>/dev/null || true
          wait "\$task_pid" || true
          return 1
        fi
        ready_wait=\$((ready_wait + 1))
        if (( ready_wait >= 600 )); then
          echo "ERROR: eBPF tracer readiness timed out after 60 seconds." >&2
          kill -TERM "\$audit_pid" 2>/dev/null || true
          wait "\$audit_pid" || true
          kill -TERM "\$task_pid" 2>/dev/null || true
          kill -CONT "\$task_pid" 2>/dev/null || true
          wait "\$task_pid" || true
          return 1
        fi
        sleep 0.1
      done

      kill -CONT "\$task_pid"
      local resume_confirmed=false
      for _ in \$(seq 1 100); do
        if ! kill -0 "\$task_pid" 2>/dev/null; then
          resume_confirmed=true
          break
        fi
        task_state="\$(awk '/^State:/ {print \$2}' "/proc/\$task_pid/status" 2>/dev/null || true)"
        if [[ "\$task_state" != T && "\$task_state" != t ]]; then
          resume_confirmed=true
          break
        fi
        kill -CONT "\$task_pid" 2>/dev/null || true
        sleep 0.01
      done
      if [[ "\$resume_confirmed" != true ]]; then
        echo "ERROR: eBPF target remained stopped after tracer readiness." >&2
        kill -TERM "\$audit_pid" 2>/dev/null || true
        wait "\$audit_pid" || true
        kill -TERM "\$task_pid" 2>/dev/null || true
        kill -CONT "\$task_pid" 2>/dev/null || true
        wait "\$task_pid" || true
        return 1
      fi

      local task_status=0
      wait "\$task_pid" || task_status=\$?
      wait "\$audit_pid" || true
      return \$task_status
    }
    """
  }
}
