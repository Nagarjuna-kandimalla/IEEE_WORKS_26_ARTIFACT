/* Additive process-targeted eBPF overlay for unmodified nf-core workflows. */

params {
    ebpf_enabled       = false
    ebpf_process_regex = '.*'
    ebpf_audit_every_n = 1
    ebpf_python        = System.getenv('EBPF_PYTHON') ?: '/usr/bin/python3'
    ebpf_tracer        = System.getenv('EBPF_TRACER') ?: "${projectDir}/../../AUDIT/helper_scripts/exp2/ebpf_audit_py39.py"
    ebpf_output_root   = null
}

process {
    beforeScript = {
        if (!params.ebpf_enabled || !(task.process ==~ params.ebpf_process_regex)) {
            return ''
        }

        def everyN = (params.ebpf_audit_every_n ?: 1) as int
        if (everyN < 1) {
            throw new IllegalArgumentException('ebpf_audit_every_n must be at least 1')
        }
        if (((task.index as int) - 1) % everyN != 0) {
            return ''
        }

        def root = params.ebpf_output_root ?: "${params.outdir}/ebpf"
        def processName = task.process
        def processDir = processName.replaceAll('[^A-Za-z0-9._-]', '__')
        def taskHash = task.hash.toString().replace('/', '')
        def traceDir = "${root}/${processDir}/task_${taskHash}"

        """
        sudo -n true >/dev/null 2>&1 || {
            echo 'ERROR: eBPF tasks require passwordless sudo on the task host.' >&2
            exit 1
        }
        sudo -n '${params.ebpf_python}' -c 'from bcc import BPF' >/dev/null 2>&1 || {
            echo 'ERROR: system Python cannot import BCC on the task host.' >&2
            exit 1
        }
        [[ -f '${params.ebpf_tracer}' ]] || {
            echo 'ERROR: eBPF tracer is missing: ${params.ebpf_tracer}' >&2
            exit 1
        }

        mkdir -p '${traceDir}'
        printf '%s\n' '${processName}' > '${traceDir}/process_name.txt'
        __nxf_launch_def="\$(declare -f nxf_launch)"
        eval "\$(printf '%s\n' "\$__nxf_launch_def" | sed '1s/nxf_launch/nxf_launch_orig/')"
        export -f nxf_launch_orig

        nxf_launch() {
            local ready_file='${traceDir}/audit_ready.txt'
            rm -f "\$ready_file"
            _ebpf_task() { kill -STOP "\$BASHPID"; nxf_launch_orig; }
            _ebpf_task &
            local task_pid=\$!
            echo "\$task_pid" > '${traceDir}/task_pid.txt'

            sudo -n '${params.ebpf_python}' '${params.ebpf_tracer}' \
                --pid "\$task_pid" --ready-file "\$ready_file" --outdir '${traceDir}' \
                > '${traceDir}/audit_stdout.log' 2> '${traceDir}/audit_stderr.log' < /dev/null &
            local audit_pid=\$!

            while [[ ! -f "\$ready_file" ]]; do
                if ! kill -0 "\$audit_pid" 2>/dev/null; then
                    wait "\$audit_pid" || true
                    kill -CONT "\$task_pid" 2>/dev/null || true
                    wait "\$task_pid" || true
                    return 1
                fi
                sleep 0.1
            done

            kill -CONT "\$task_pid"
            local status=0
            wait "\$task_pid" || status=\$?
            wait "\$audit_pid" || true
            return \$status
        }
        """
    }
}
