// The source workflow has no eBPF overlay unless one is supplied with -c.
// This file exists to make the no-audit experiment explicit and reproducible.
params {
    n_windows = 1500
    queue_size = 416
}

profiles {
    slurm {
        process.queue = System.getenv('CAMP_SLURM_QUEUE') ?: 'main'
        executor.queueSize = 416
    }
}
