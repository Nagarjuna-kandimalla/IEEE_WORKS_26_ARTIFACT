/* Additive process-targeted strace overlay for unmodified nf-core workflows. */

params {
    strace_enabled       = false
    strace_process_regex = '.*'
    strace_output_root   = null
}

process {
    beforeScript = {
        if (!params.strace_enabled || !(task.process ==~ params.strace_process_regex)) {
            return ''
        }

        def root = params.strace_output_root ?: "${params.outdir}/strace"
        def processName = task.process
        def processDir = processName.replaceAll('[^A-Za-z0-9._-]', '__')
        def taskHash = task.hash.toString().replace('/', '')
        def taskDir = "${root}/${processDir}/task_${taskHash}"
        def localTag = "${processDir}_task_${taskHash}"

        """
        command -v strace >/dev/null 2>&1 || {
            echo 'ERROR: strace is required for the selected process.' >&2
            exit 1
        }
        command -v find >/dev/null 2>&1 || {
            echo 'ERROR: find is required for strace log consolidation.' >&2
            exit 1
        }
        rm -rf '${taskDir}'
        mkdir -p '${taskDir}'
        printf '%s\n' '${processName}' > '${taskDir}/process_name.txt'
        __nxf_launch_def="\$(declare -f nxf_launch)"
        eval "\$(printf '%s\n' "\$__nxf_launch_def" | sed '1s/nxf_launch/nxf_launch_orig/')"
        export -f nxf_launch_orig
        if declare -F nxf_container_env >/dev/null; then
            export -f nxf_container_env
        fi
        nxf_launch() {
            local trace_status
            local trace_count
            local local_trace_dir="\${SLURM_TMPDIR:-/tmp}/mempred-strace/\${SLURM_JOB_ID:-nojob}_${localTag}"
            rm -rf "\$local_trace_dir"
            mkdir -p "\$local_trace_dir"

            if strace -ff -o "\$local_trace_dir/strace.log" \
                -e trace=read,write,pread64,pwrite64,readv,writev,preadv,pwritev,mmap,mmap2 \
                -e raw=read,write,pread64,pwrite64,readv,writev,preadv,pwritev,mmap,mmap2 \
                bash -c nxf_launch_orig; then
                trace_status=0
            else
                trace_status=\$?
            fi

            trace_count="\$(find "\$local_trace_dir" -maxdepth 1 -type f -name 'strace.log.*' -printf '.' | wc -c)"
            printf '%s\n' "\$trace_count" > '${taskDir}/strace_file_count.txt'
            if (( trace_count > 0 )); then
                LC_ALL=C cat "\$local_trace_dir"/strace.log.* > '${taskDir}/strace.log.combined.tmp'
                mv '${taskDir}/strace.log.combined.tmp' '${taskDir}/strace.log.combined'
            fi
            rm -rf "\$local_trace_dir"
            return "\$trace_status"
        }
        """
    }
}
