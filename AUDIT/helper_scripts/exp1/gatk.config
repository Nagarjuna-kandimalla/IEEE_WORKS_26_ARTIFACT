params {
    instrumentation = 'strace'
    samples = "${projectDir}/data/samples_20.tsv"
    dataset_id = 'gatk_synthetic_20samples_25scatters'
    outdir = "${projectDir}/exp_1_strace_online/results"
    slurm_exclude_nodes = ''
    slurm_node_list = ''
    queue_size = 416
}

executor {
    queueSize = params.queue_size
}

profiles {
    slurm {
        executor.queueSize = 416
    }
}

// HaplotypeCaller starts its own strace so its task_metrics.tsv can parse the
// syscall counts. All other workflow processes are traced here.
process {
    beforeScript = {
        def processName = task.process.tokenize(':')[-1]
        def taskId = task.hash.toString().replace('/', '')
        def tracePrefix = "${params.outdir}/strace/${processName}/task_${taskId}/strace.log"
        """
        command -v strace >/dev/null 2>&1 || { echo 'ERROR: strace is required.' >&2; exit 1; }
        mkdir -p "\$(dirname '${tracePrefix}')"
        __nxf_launch_def="\$(declare -f nxf_launch)"
        eval "\$(printf '%s\\n' "\$__nxf_launch_def" | sed '1s/nxf_launch/nxf_launch_orig/')"
        export -f nxf_launch_orig
        nxf_launch() {
          strace -ff -o '${tracePrefix}' -e trace=read,write,pread64,pwrite64,readv,writev,preadv,pwritev,mmap,mmap2 bash -c nxf_launch_orig
        }
        """
    }

    withName: HAPLOTYPECALLER {
        beforeScript = ''
    }
}
