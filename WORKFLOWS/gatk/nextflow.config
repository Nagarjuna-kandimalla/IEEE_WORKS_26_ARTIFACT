nextflow.enable.dsl = 2

params {
    outdir = "${projectDir}/results"
    reference = "${projectDir}/data/hg38_synthetic.fa"
    samples = "${projectDir}/data/samples_20.tsv"
    intervals = "${projectDir}/data/intervals_25.tsv"
    dataset_id = "gatk_synthetic_20samples_25scatters"
    gatk_jar = System.getenv('GATK_JAR') ?: ''
    bwa_image = System.getenv('BWA_IMAGE') ?: ''
    samtools_image = System.getenv('SAMTOOLS_IMAGE') ?: ''
    apptainer_bind = System.getenv('APPTAINER_BIND') ?: projectDir.toString()
    instrumentation = "none"
    task_plan = ""
    ebpf_python = System.getenv('CAMP_PYTHON') ?: '/usr/bin/python3'
    ebpf_tracer_python = System.getenv('EBPF_PYTHON') ?: '/usr/bin/python3'
    ebpf_runner = "${projectDir}/../../AUDIT/helper_scripts/exp2/run_with_optional_audit.py"
    ebpf_script = "${projectDir}/../../AUDIT/helper_scripts/exp2/ebpf_audit_py39.py"
    java_heap_mb = 3072
    hc_threads = 2
    queue_size = 128
    slurm_exclude_nodes = ""
    slurm_node_list = ""
    slurm_cluster_options = ""
    online_memory_plan = ""
    online_system_config_id = "sc13"
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: PREPARE_REFERENCE {
        cpus = 1
        memory = '2 GB'
    }
    withName: SIMULATE_FASTQ {
        cpus = 1
        memory = '2 GB'
    }
    withName: BUILD_BWA_INDEX {
        cpus = 2
        memory = '4 GB'
    }
    withName: ALIGN_AND_INDEX {
        cpus = 2
        memory = '6 GB'
    }
    withName: HAPLOTYPECALLER {
        cpus = params.hc_threads
    }
}

profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        process.queue = System.getenv('CAMP_SLURM_QUEUE') ?: 'main'
        process.clusterOptions = params.slurm_exclude_nodes ? "--exclude=${params.slurm_exclude_nodes}" : (params.slurm_node_list ? "--nodelist=${params.slurm_node_list}" : (params.slurm_cluster_options instanceof Boolean ? "" : params.slurm_cluster_options))
        executor.queueSize = params.queue_size
    }
}
