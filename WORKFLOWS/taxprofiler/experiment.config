params {
    validate_params              = false
    input                        = "${launchDir}/WORKFLOWS/taxprofiler/data/ENA_metagenomic_WGS_5998.https.csv"
    databases                    = "${launchDir}/WORKFLOWS/taxprofiler/data/kraken2_standard8_20260626.remote.csv"
    run_kraken2                  = true
    skip_preprocessing_qc        = true
    perform_shortread_qc         = false
    perform_runmerging           = false
    run_profile_standardisation  = false
    run_krona                    = false
    publish_dir_mode             = 'copy'
}

process {
    executor      = 'slurm'
    queue         = System.getenv('CAMP_SLURM_QUEUE') ?: 'main'
    errorStrategy = 'retry'
    maxRetries    = 5
    maxErrors     = -1

    withName: '.*KRAKEN2_KRAKEN2' {
        cpus   = 4
        memory = '16 GB'
        time   = '6h'
        container = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/0f/0f827dcea51be6b5c32255167caa2dfb65607caecdc8b067abd6b71c267e2e82/data'
    }
}

executor.queueSize = 416

filePorter {
    maxRetries   = 12
    maxTransfers = 16
}

trace {
    overwrite = true
    fields = 'task_id,hash,native_id,name,process,tag,status,exit,submit,duration,realtime,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,workdir'
}

report { overwrite = true }
timeline { overwrite = true }
dag { overwrite = true }
