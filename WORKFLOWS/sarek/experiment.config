params {
    validate_params         = false
    input                   = "${launchDir}/WORKFLOWS/sarek/data/NA12878_WGS_30x_full_test.remote.csv"
    intervals               = "${launchDir}/WORKFLOWS/sarek/data/GRCh38_primary_1495.bed"
    genome                  = 'GATK.GRCh38'
    tools                   = 'haplotypecaller'
    nucleotides_per_second  = 200000
    publish_dir_mode        = 'copy'
}

process {
    executor      = 'slurm'
    queue         = System.getenv('CAMP_SLURM_QUEUE') ?: 'main'
    errorStrategy = 'retry'
    maxRetries    = 5
    maxErrors     = -1

    withName: '.*GATK4_HAPLOTYPECALLER' {
        cpus   = 2
        memory = '16 GB'
        time   = '8h'
    }

    withName: '.*MERGE_HAPLOTYPECALLER' {
        cpus   = 2
        memory = '32 GB'
        time   = '8h'
    }
}

executor.queueSize = 416

report { overwrite = true }
timeline { overwrite = true }
dag { overwrite = true }

trace {
    overwrite = true
    fields = 'task_id,hash,native_id,name,process,tag,status,exit,submit,duration,realtime,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,workdir'
}
