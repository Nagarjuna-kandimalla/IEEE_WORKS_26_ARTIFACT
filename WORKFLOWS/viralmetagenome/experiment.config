params {
    validate_params                  = false
    input                            = "${launchDir}/WORKFLOWS/viralmetagenome/data/ENA_metagenomic_WGS_3000.viralmetagenome.csv"
    publish_dir_mode                 = 'copy'

    skip_preprocessing               = false
    skip_fastqc                      = true
    skip_trimming                    = true
    skip_complexity_filtering        = true
    skip_hostremoval                 = true
    skip_host_fastqc                 = true
    merge_reads                      = false
    with_umi                         = false
    skip_umi_extract                 = true

    skip_read_classification         = false
    read_classifiers                 = 'kraken2'
    kraken2_db                       = System.getenv('KRAKEN2_DB') ?: 'https://genome-idx.s3.amazonaws.com/kraken/k2_standard_08_GB_20260626.tar.gz'
    kraken2_save_reads               = false
    kraken2_save_readclassification  = false
    kraken2_save_minimizers          = false
    save_databases                   = false

    skip_assembly                    = true
    skip_polishing                   = true
    skip_iterative_refinement        = true
    skip_precluster                  = true
    precluster_classifiers           = null
    skip_variant_calling             = true
    skip_vcf_annotation              = true
    skip_consensus_qc                = true
    skip_checkv                      = true
    skip_prokka                      = true
    skip_quast                       = true
    skip_blast_qc                    = true
    skip_alignment_qc                = true
    skip_consensus_annotation        = true
}

process {
    executor      = 'slurm'
    queue         = System.getenv('CAMP_SLURM_QUEUE') ?: 'main'
    errorStrategy = 'retry'
    maxRetries    = 5

    withName: '.*UNTAR_DB' {
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }

    withName: '.*KRAKEN2_KRAKEN2' {
        cpus   = 4
        memory = '16 GB'
        time   = '6h'
        ext.args = '--memory-mapping --quick'
    }

    withName: '.*KRAKENTOOLS_KREPORT2KRONA' {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: '.*KRONA_CLEANUP' {
        cpus   = 1
        memory = '4 GB'
        time   = '4h'
    }

    withName: '.*KRONA_KTIMPORTTEXT' {
        cpus   = 1
        memory = '8 GB'
        time   = '6h'
    }

    withName: '.*CUSTOM_MULTIQC' {
        cpus   = 2
        memory = '8 GB'
        time   = '6h'
    }
}

executor.queueSize = 416

trace {
    overwrite = true
    fields = 'task_id,hash,native_id,name,process,tag,status,exit,submit,duration,realtime,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,workdir'
}
