    1998,
    1999,
    2000
  ],
  "expected_rows": 33516,
  "expected_train_rows": 28490,
  "expected_test_rows": 5026,
  "expected_original_train_rows": 23460,
  "expected_original_calibration_rows": 5030,
  "expected_workflows": 6,
  "expected_processes": 42,
  "history": {
    "initial_training_mode": "warm_leave_one_out",
    "nearest_k": 48,
    "scope_window": 512,
    "exact_min_support": 2,
    "input_min_support": 3,
    "nearest_min_support": 8,
    "process_min_support": 16,
    "workflow_min_support": 32
  },
  "models": {
    "folds": 5,
    "model_seeds": [
      20260728,
      20260729,
      20260730
    ],
    "quantiles": [
      0.5,
      0.9,
      0.95,
      0.99,
      0.995
    ],
    "n_estimators": 350,
    "learning_rate": 0.03
  },
  "point_stack": {
    "minimum_static_anchor_weight": 0.9,
    "weight_grid_step": 0.1,
    "tie_penalty_toward_A": 0.002
  },
  "allocation": {
    "final_contract": "dual_history_dynamic_safety_bound",
    "dynamic_tail_quantile": 0.995,
    "enhanced_policy_scope": "global",
