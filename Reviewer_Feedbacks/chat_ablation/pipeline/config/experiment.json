      0.9,
      0.95,
      0.975,
      0.99,
      0.995,
      0.999
    ],
    "base_policies": [
      "point_q50",
      "neighbour_p95",
      "neighbour_p99",
      "model_q90",
      "model_q95",
      "model_q99",
      "model_q995"
    ],
    "retry_multiplier": 1.5
  },
  "variants": [
    "A+P",
    "A+P+C"
  ],
  "feature_contract": {
    "A": "prelaunch static task and system features",
    "P": "causal prior peak-RSS history, support, confidence, and similarity",
    "C": "causal prior consumed-data history plus predicted current consumed bytes"
  },
  "consumed_target": "ebpf_total_consumed_bytes",
  "consumed_formula": "ebpf_read_return_bytes + ebpf_mmap_page_fault_bytes",
  "rss_target": "peak_memory_bytes"
